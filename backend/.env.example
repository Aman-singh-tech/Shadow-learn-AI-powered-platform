PORT=5000
MONGODB_URI=mongodb+srv://your_user:your_pass@cluster.mongodb.net/Shadowlearn
JWT_SECRET=your_super_secret_jwt_key
GEMINI_API_KEY=your_google_gemini_api_key

# CORS for local dev. Set both to your production frontend URL on Render.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=https://your-app-name.onrender.com

# SendGrid — get your API key at: https://app.sendgrid.com/settings/api_keys
# Make sure to verify your sender email/domain at: https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# EMAIL_FROM must be a verified sender address (Single Sender Verification or authenticated domain)
EMAIL_FROM=ShadowLearn <your_verified_email@yourdomain.com>

# Cloudinary (for file uploads — required for production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
